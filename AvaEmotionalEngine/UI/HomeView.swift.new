    appState.userName = "Isaac"
    
    let metricsManager = MetricsManager.shared
    metricsManager.updateMetrics(psi: 72.5, kxrpScores: [72.5, 68.2, 75.0])
    
    return HomeView()
        .environmentObject(appState)
        .environmentObject(metricsManager)
